 "fields": [
  {
   "fieldname": "title",
   "label": "Bezeichnung",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Eigene Bezeichnung für diesen Pull-Sync, z.B. 'Hauptshop Bestellungen'."
  },
  {
   "fieldname": "backend",
   "label": "Quellsystem",
   "fieldtype": "Select",
   "options": "Shopware\nMedusa",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "label": "Aktiv (am Cron-Pull teilnehmen)",
   "fieldtype": "Check",
   "default": "0",
   "in_list_view": 1,
   "description": "Bei 0 läuft der Pull nur manuell."
  },
  {
   "fieldname": "column_break_header",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cron_preset",
   "label": "Zeitplan",
   "fieldtype": "Select",
   "options": "manual\nevery_hour\nevery_6h\ndaily_3am\ncustom",
   "default": "every_hour",
   "description": "Wie oft der Pull läuft. 'every_hour' ist Standard — Webhook + Cron als Sicherheitsnetz."
  },
  {
   "fieldname": "cron_schedule",
   "label": "Eigener Cron-Ausdruck",
   "fieldtype": "Data",
   "depends_on": "eval:doc.cron_preset==='custom'",
   "description": "5-Felder-Cron-Expression, z.B. <code>0 */2 * * *</code>"
  },
  {
   "fieldname": "targets_section",
   "fieldtype": "Section Break",
   "label": "Was geholt wird",
   "description": "Welche Entitäten beim Pull aus dem Backend abgeholt werden. Pro Run wird jede aktivierte Sektion mit ihrer Watermark abgefragt."
  },
  {
   "fieldname": "pull_orders",
   "label": "Bestellungen",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "pull_customers",
   "label": "Kunden",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "pull_inventory",
   "label": "Bestand (Backend → ERPNext)",
   "fieldtype": "Check",
   "default": "0",
   "description": "Default 0 — meist ist ERPNext die Stock-Quelle. Aktivieren nur, wenn das Backend die Wahrheit ist (z.B. POS-System)."
  },
  {
   "fieldname": "column_break_targets",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "order_status_filter",
   "label": "Bestell-Status-Filter",
   "fieldtype": "Data",
   "default": "paid,open",
   "description": "Kommagetrennte Backend-Status-Werte; bei Shopware z.B. 'paid,open,in_progress'. Leer = alle Stati."
  },
  {
   "fieldname": "lookback_hours",
   "label": "Rückblick (Stunden)",
   "fieldtype": "Int",
   "default": "168",
   "description": "Beim Erstlauf ohne Watermark wird so weit zurückgegriffen. Default 7 Tage."
  },
  {
   "fieldname": "channels_section",
   "fieldtype": "Section Break",
   "label": "Quell-Storefronts",
   "description": "Auf welche Storefronts der Pull beschränkt wird. Leer = alle Channels."
  },
  {
   "fieldname": "target_sales_channels",
   "label": "Storefronts",
   "fieldtype": "Table",
   "options": "Ecommerce Pull Sync Channel"
  },
  {
   "fieldname": "watermarks_section",
   "fieldtype": "Section Break",
   "label": "Watermarks (informativ)",
