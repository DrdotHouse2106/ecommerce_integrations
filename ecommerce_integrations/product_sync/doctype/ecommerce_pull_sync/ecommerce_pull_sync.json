 "fields": [
  {
   "fieldname": "title",
   "label": "Bezeichnung",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Internal label for this Pull Sync, e.g. 'Main shop orders'."
  },
  {
   "fieldname": "backend",
   "label": "Quellsystem",
   "fieldtype": "Select",
   "options": "Shopware\nMedusa",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "label": "Aktiv (am Cron-Pull teilnehmen)",
   "fieldtype": "Check",
   "default": "0",
   "in_list_view": 1,
   "description": "When 0, pull only runs manually."
  },
  {
   "fieldname": "column_break_header",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cron_preset",
   "label": "Schedule",
   "fieldtype": "Select",
   "options": "manual\nevery_hour\nevery_6h\ndaily_3am\ncustom",
   "default": "every_hour",
   "description": "How often the pull runs. 'every_hour' is the default — webhook + cron as a safety net."
  },
  {
   "fieldname": "cron_schedule",
   "label": "Eigener Cron-Ausdruck",
   "fieldtype": "Data",
   "depends_on": "eval:doc.cron_preset==='custom'",
   "description": "5-Felder-Cron-Expression, z.B. <code>0 */2 * * *</code>"
  },
  {
   "fieldname": "targets_section",
   "fieldtype": "Section Break",
   "label": "What is pulled",
   "description": "Which entities are pulled from the backend. Per run, each enabled section is queried using its watermark."
  },
  {
   "fieldname": "pull_orders",
   "label": "Bestellungen",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "pull_customers",
   "label": "Kunden",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "pull_inventory",
   "label": "Bestand (Backend → ERPNext)",
   "fieldtype": "Check",
   "default": "0",
   "description": "Default 0 — usually ERPNext is the source of stock truth. Enable only when the backend is the source of truth (e.g. POS)."
  },
  {
   "fieldname": "column_break_targets",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "order_status_filter",
   "label": "Bestell-Status-Filter",
   "fieldtype": "Data",
   "default": "paid,open",
   "description": "Kommagetrennte Backend-Status-Werte; bei Shopware z.B. 'paid,open,in_progress'. Leer = alle Stati."
  },
  {
   "fieldname": "lookback_hours",
   "label": "Lookback (hours)",
   "fieldtype": "Int",
   "default": "168",
   "description": "On the first run without a watermark, this is how far back to look. Default 7 days."
  },
  {
   "fieldname": "channels_section",
   "fieldtype": "Section Break",
